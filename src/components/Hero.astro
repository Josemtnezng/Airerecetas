---
---
<section class="relative overflow-hidden bg-gradient-to-b from-orange-50 via-slate-50 to-slate-50 py-12 sm:py-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="grid items-center gap-8 lg:grid-cols-12 lg:gap-12">
      <!-- Texto Principal -->
      <div class="lg:col-span-7 text-center lg:text-left">
        <span class="inline-flex items-center gap-2 rounded-full bg-orange-100 px-3.5 py-1.5 text-xs font-bold text-orange-700">
          ✨ Adaptadas para Freidora de Aire
        </span>
        <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
          Recetas crujientes,<br/>
          <span class="bg-gradient-to-r from-orange-600 to-amber-500 bg-clip-text text-transparent">
            sin complicaciones.
          </span>
        </h1>
        <p class="mt-4 text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto lg:mx-0">
          Ahorra tiempo y energía. Tiempos exactos, temperaturas calculadas e ingredientes en español para que tus platos queden impecables siempre.
        </p>

        <!-- Métricas Rápidas -->
        <div class="mt-8 flex flex-wrap items-center justify-center lg:justify-start gap-6 border-t border-slate-200/60 pt-6">
          <div class="flex items-center gap-2">
            <span class="text-2xl">⚡</span>
            <div class="text-left">
              <p class="text-xs font-medium text-slate-500">Tiempo medio</p>
              <p class="text-sm font-bold text-slate-800">15-20 mins</p>
            </div>
          </div>
          <div class="h-8 w-px bg-slate-200 hidden sm:block"></div>
          <div class="flex items-center gap-2">
            <span class="text-2xl">🌿</span>
            <div class="text-left">
              <p class="text-xs font-medium text-slate-500">Aceite</p>
              <p class="text-sm font-bold text-slate-800">-85% grasas</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Banner / Imagen Ilustrativa -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md overflow-hidden rounded-3xl bg-white p-4 shadow-2xl shadow-orange-500/10 ring-1 ring-slate-100">
          <img 
            src="https://images.unsplash.com/photo-1527477396000-e27163b481c2?auto=format&fit=crop&w=800&q=80" 
            alt="Pollo crujiente en Airfryer" 
            class="h-64 w-full rounded-2xl object-cover"
          />
          <div class="mt-4 flex items-center justify-between px-2">
            <div>
              <span class="text-xs font-bold text-orange-600 uppercase tracking-wider">Destacado del día</span>
              <h3 class="text-lg font-bold text-slate-900">Alitas de Pollo Super Crujientes</h3>
            </div>
            <span class="rounded-xl bg-orange-50 px-3 py-1.5 text-xs font-extrabold text-orange-700">
               200°C
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>