---
interface Props {
  title: string;
  slug: string;
  description: string;
  cookTimeMinutes: number;
  temperatureCelsius: number;
  category?: string;
  imageUrl?: string;
}

const {
  title,
  slug,
  description,
  cookTimeMinutes,
  temperatureCelsius,
  category = "Airfryer",
  imageUrl = "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=600&q=80"
} = Astro.props;
---

<article class="group relative flex flex-col overflow-hidden rounded-2xl bg-white border border-slate-200/80 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-orange-500/5 hover:border-orange-200">
  <!-- Imagen + Badges -->
  <div class="relative h-48 w-full overflow-hidden bg-slate-100">
    <img 
      src={imageUrl} 
      alt={title} 
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-transparent opacity-60"></div>

    <!-- Badge Categoría -->
    <span class="absolute left-3 top-3 rounded-full bg-white/90 backdrop-blur-md px-3 py-1 text-xs font-bold text-slate-800 shadow-sm">
      {category}
    </span>

    <!-- Indicador de Temp y Tiempo -->
    <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-xs font-semibold text-white">
      <span class="flex items-center gap-1 rounded-lg bg-slate-900/80 px-2.5 py-1 backdrop-blur-sm">
        ⏱️ {cookTimeMinutes} min
      </span>
      <span class="flex items-center gap-1 rounded-lg bg-orange-600/90 px-2.5 py-1 backdrop-blur-sm font-bold">
        🌡️ {temperatureCelsius}°C
      </span>
    </div>
  </div>

  <!-- Contenido -->
  <div class="flex flex-1 flex-col justify-between p-5">
    <div>
      <h3 class="text-lg font-bold text-slate-900 group-hover:text-orange-600 transition-colors line-clamp-1">
        <a href={`/recetas/${slug}`}>
          <span class="absolute inset-0"></span>
          {title}
        </a>
      </h3>
      <p class="mt-2 text-xs text-slate-600 line-clamp-2 leading-relaxed">
        {description}
      </p>
    </div>

    <!-- Botón / Acción -->
    <div class="mt-4 flex items-center justify-between border-t border-slate-100 pt-3 text-xs font-bold text-orange-600">
      <span>Ver receta completa</span>
      <span class="transition-transform group-hover:translate-x-1">→</span>
    </div>
  </div>
</article>