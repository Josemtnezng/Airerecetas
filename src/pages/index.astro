---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import RecipeCard from '../components/RecipeCard.astro';

const recipesDir = path.join(process.cwd(), 'src', 'content', 'recipes');
let recipes = [];

if (fs.existsSync(recipesDir)) {
  const files = fs.readdirSync(recipesDir).filter(file => file.endsWith('.json'));
  recipes = files.map(file => {
    const content = fs.readFileSync(path.join(recipesDir, file), 'utf-8');
    return JSON.parse(content);
  });
}

const categories = ["Todas", "Carnes", "Pescados", "Verduras", "Snacks", "Postres"];
---

<Layout title="Aire Recetas - Tu Guía de Cocina en Freidora de Aire">
  <Header />
  <Hero />

  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
    
    <!-- BARRA DE BÚSQUEDA Y NAVEGACIÓN POR CATEGORÍAS -->
    <div class="mb-10 space-y-6">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <h2 class="text-2xl font-extrabold text-slate-900 sm:text-3xl">Explorar Recetas</h2>
          <p class="text-sm text-slate-500 mt-1">Busca tu plato preferido o filtra por tipo de comida</p>
        </div>

        <!-- Buscador en tiempo real -->
        <div class="relative w-full md:w-80">
          <input 
            type="text" 
            id="searchInput"
            placeholder="Buscar receta (ej: pollo, salmón)..." 
            class="w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 pl-10 text-sm text-slate-800 placeholder-slate-400 shadow-sm focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-500/20"
          />
          <span class="absolute left-3 top-3 text-slate-400 text-sm">🔍</span>
        </div>
      </div>

      <!-- Pills de Filtro por Categoría -->
      <div class="flex flex-wrap gap-2 pt-2 border-b border-slate-100 pb-4">
        {categories.map((cat, index) => (
          <button 
            data-category={cat}
            class={`category-btn px-4 py-2 rounded-xl text-sm font-semibold transition ${
              index === 0 
                ? 'bg-orange-600 text-white shadow-sm' 
                : 'bg-slate-100 text-slate-600 hover:bg-slate-200'
            }`}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <!-- GRID DE RECETAS -->
    {recipes.length > 0 ? (
      <div id="recipeGrid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {recipes.map(recipe => (
          <div 
            class="recipe-item" 
            data-title={recipe.title.toLowerCase()} 
            data-category={recipe.category}
          >
            <RecipeCard
              title={recipe.title}
              slug={recipe.slug}
              description={recipe.description}
              cookTimeMinutes={recipe.cookTimeMinutes}
              temperatureCelsius={recipe.temperatureCelsius}
              category={recipe.category}
              imageUrl={recipe.imageUrl}
            />
          </div>
        ))}
      </div>
    ) : (
      <div class="rounded-2xl border-2 border-dashed border-slate-200 bg-white p-12 text-center">
        <span class="text-4xl">🍳</span>
        <h3 class="mt-3 text-lg font-bold text-slate-800">Aún no hay recetas en el recetario</h3>
        <p class="mt-1 text-sm text-slate-500">
          Ejecuta <code class="bg-slate-100 px-2 py-1 rounded text-orange-600 font-mono">node generate-recipes.js</code> para cargar la base de datos.
        </p>
      </div>
    )}

    <!-- Mensaje cuando la búsqueda no devuelve resultados -->
    <div id="noResults" class="hidden rounded-2xl bg-slate-50 p-12 text-center border border-slate-100 my-8">
      <span class="text-3xl">🔍</span>
      <h3 class="mt-2 text-base font-bold text-slate-700">No se encontraron recetas</h3>
      <p class="text-xs text-slate-500 mt-1">Prueba a buscar con otra palabra clave o selecciona otra categoría.</p>
    </div>

  </section>
</Layout>

<!-- LÓGICA DE FILTRADO Y BÚSQUEDA INTERACTIVA EN CLIENTE -->
<script>
  const searchInput = document.getElementById('searchInput');
  const categoryBtns = document.querySelectorAll('.category-btn');
  const recipeItems = document.querySelectorAll('.recipe-item');
  const noResults = document.getElementById('noResults');

  let currentCategory = 'Todas';
  let searchQuery = '';

  function filterRecipes() {
    let visibleCount = 0;

    recipeItems.forEach(item => {
      const title = item.getAttribute('data-title') || '';
      const category = item.getAttribute('data-category') || '';

      const matchesSearch = title.includes(searchQuery);
      const matchesCategory = currentCategory === 'Todas' || category === currentCategory;

      if (matchesSearch && matchesCategory) {
        item.classList.remove('hidden');
        visibleCount++;
      } else {
        item.classList.add('hidden');
      }
    });

    if (noResults) {
      if (visibleCount === 0) {
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }
    }
  }

  // Evento de búsqueda por texto
  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
    filterRecipes();
  });

  // Evento de cambio de categoría
  categoryBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      categoryBtns.forEach(b => {
        b.classList.remove('bg-orange-600', 'text-white', 'shadow-sm');
        b.classList.add('bg-slate-100', 'text-slate-600');
      });

      btn.classList.remove('bg-slate-100', 'text-slate-600');
      btn.classList.add('bg-orange-600', 'text-white', 'shadow-sm');

      currentCategory = btn.getAttribute('data-category') || 'Todas';
      filterRecipes();
    });
  });
</script>