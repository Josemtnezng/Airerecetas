---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Calculadora de Horno a Airfryer - Aire Recetas">
  <Header />
  <main class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-black text-slate-900">Conversor de Horno a Airfryer</h1>
      <p class="text-slate-500 mt-2">Adapta cualquier receta tradicional de horno a tu freidora de aire al instante.</p>
    </div>

    <div class="bg-white border border-slate-200 rounded-3xl p-8 shadow-sm space-y-6">
      <div>
        <span class="block text-sm font-bold text-slate-700 mb-2">Tipo de horno</span>
        <div class="grid grid-cols-2 gap-3" role="radiogroup" aria-label="Tipo de horno">
          <label class="cursor-pointer">
            <input type="radio" name="ovenType" value="conventional" class="peer sr-only" checked />
            <div class="rounded-xl border border-slate-200 p-3 text-center text-sm font-semibold text-slate-600 peer-checked:border-orange-500 peer-checked:bg-orange-50 peer-checked:text-orange-700 peer-focus-visible:ring-2 peer-focus-visible:ring-orange-500">
              Convencional
            </div>
          </label>
          <label class="cursor-pointer">
            <input type="radio" name="ovenType" value="fan" class="peer sr-only" />
            <div class="rounded-xl border border-slate-200 p-3 text-center text-sm font-semibold text-slate-600 peer-checked:border-orange-500 peer-checked:bg-orange-50 peer-checked:text-orange-700 peer-focus-visible:ring-2 peer-focus-visible:ring-orange-500">
              Con ventilador
            </div>
          </label>
        </div>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label for="ovenTemp" class="block text-sm font-bold text-slate-700 mb-2">Temperatura del horno (°C)</label>
          <input type="number" id="ovenTemp" value="200" min="50" max="300" step="5" inputmode="numeric"
            class="w-full rounded-xl border border-slate-200 p-3 text-slate-800 focus:ring-2 focus:ring-orange-500 focus:outline-none" />
        </div>

        <div>
          <label for="ovenTime" class="block text-sm font-bold text-slate-700 mb-2">Tiempo en horno (minutos)</label>
          <input type="number" id="ovenTime" value="30" min="1" max="300" step="1" inputmode="numeric"
            class="w-full rounded-xl border border-slate-200 p-3 text-slate-800 focus:ring-2 focus:ring-orange-500 focus:outline-none" />
        </div>
      </div>

      <div class="bg-orange-50 border border-orange-200 rounded-2xl p-6 text-center space-y-2">
        <h3 class="text-xs uppercase tracking-wider font-extrabold text-orange-800">Ajuste recomendado para Airfryer</h3>
        <div class="text-2xl font-black text-orange-600" id="resultText" aria-live="polite">
          180°C durante 24 minutos
        </div>
        <p class="text-xs text-orange-700 mt-1" id="ruleText">
          Regla general: reduce 20°C y el tiempo un 20%.
        </p>
      </div>

      <ul class="text-sm text-slate-600 space-y-2 list-disc pl-5" id="tips"></ul>
    </div>
  </main>

  <script>
    const ovenTemp = document.getElementById('ovenTemp') as HTMLInputElement;
    const ovenTime = document.getElementById('ovenTime') as HTMLInputElement;
    const resultText = document.getElementById('resultText');
    const ruleText = document.getElementById('ruleText');
    const tips = document.getElementById('tips');
    const ovenTypes = document.querySelectorAll<HTMLInputElement>('input[name="ovenType"]');

    const MAX_AIRFRYER_TEMP = 200;
    const MIN_AIRFRYER_TEMP = 80;

    function calculate() {
      const temp = parseFloat(ovenTemp.value);
      const time = parseFloat(ovenTime.value);

      if (!resultText || !ruleText || !tips) return;

      if (!temp || !time || temp <= 0 || time <= 0) {
        resultText.textContent = 'Introduce temperatura y tiempo';
        ruleText.textContent = '';
        tips.innerHTML = '';
        return;
      }

      const type = (document.querySelector('input[name="ovenType"]:checked') as HTMLInputElement)?.value;
      const reduction = type === 'fan' ? 10 : 20;

      // Redondeo a múltiplos de 5°C y límites de la freidora
      let airfryerTemp = Math.round((temp - reduction) / 5) * 5;
      airfryerTemp = Math.min(MAX_AIRFRYER_TEMP, Math.max(MIN_AIRFRYER_TEMP, airfryerTemp));
      const airfryerTime = Math.max(1, Math.round(time * 0.8));

      resultText.textContent = `${airfryerTemp}°C durante ${airfryerTime} minutos`;
      ruleText.textContent = `Horno ${type === 'fan' ? 'con ventilador' : 'convencional'}: -${reduction}°C y -20% de tiempo.`;

      const messages: string[] = [
        'Precalienta la airfryer 3-5 minutos si la receta lo pide.',
        'No amontones la comida: el aire tiene que circular.',
      ];
      if (temp - reduction > MAX_AIRFRYER_TEMP) {
        messages.unshift(`Tu horno supera el máximo habitual de una airfryer (${MAX_AIRFRYER_TEMP}°C). Cocina a ${MAX_AIRFRYER_TEMP}°C y revisa antes.`);
      }
      if (airfryerTime > 25) {
        messages.push('Es un tiempo largo: remueve o da la vuelta a mitad de cocción.');
      } else {
        messages.push('Revisa el punto 2-3 minutos antes de que acabe; la airfryer cocina rápido.');
      }
      tips.innerHTML = messages.map((m) => `<li>${m}</li>`).join('');
    }

    ovenTemp.addEventListener('input', calculate);
    ovenTime.addEventListener('input', calculate);
    ovenTypes.forEach((r) => r.addEventListener('change', calculate));

    calculate();
  </script>
</Layout>