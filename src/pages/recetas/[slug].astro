---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

export async function getStaticPaths() {
  const recipesDir = path.join(process.cwd(), 'src', 'content', 'recipes');
  
  if (!fs.existsSync(recipesDir)) {
    return [];
  }

  const files = fs.readdirSync(recipesDir).filter(file => file.endsWith('.json'));

  return files.map(file => {
    const content = fs.readFileSync(path.join(recipesDir, file), 'utf-8');
    const recipe = JSON.parse(content);
    return {
      params: { slug: recipe.slug },
      props: { recipe }
    };
  });
}

const { recipe } = Astro.props;
---

<Layout 
  title={`${recipe.title} en Airfryer - Aire Recetas`}
  description={recipe.description}
>
  <Header />

  <div class="w-full bg-slate-50 py-8 sm:py-12">
    <main class="mx-auto max-w-5xl px-4 sm:px-6">
      <!-- Migas de pan -->
      <nav class="mb-6 flex items-center gap-2 text-xs font-semibold text-slate-500">
        <a href="/" class="hover:text-orange-600 transition-colors">Inicio</a>
        <span>/</span>
        <span class="text-slate-400">{recipe.category || 'Receta'}</span>
        <span>/</span>
        <span class="text-slate-800 truncate max-w-[200px]">{recipe.title}</span>
      </nav>

      <!-- Encabezado de Receta -->
      <header class="mb-8">
        <span class="inline-block rounded-full bg-orange-100 px-3 py-1 text-xs font-bold text-orange-700 uppercase tracking-wide">
          {recipe.category || 'Airfryer'}
        </span>
        <h1 class="mt-3 text-3xl font-extrabold text-slate-900 sm:text-4xl md:text-5xl">
          {recipe.title}
        </h1>
        <p class="mt-3 text-base text-slate-600 leading-relaxed max-w-3xl">
          {recipe.description}
        </p>
      </header>

      <!-- Ficha Técnica Resumen -->
      <div class="mb-10 grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
        <div class="rounded-2xl border border-slate-200 bg-white p-4 text-center shadow-sm">
          <span class="text-xl">⏱️</span>
          <p class="mt-1 text-xs font-medium text-slate-500">Preparación</p>
          <p class="text-sm font-bold text-slate-800">{recipe.prepTimeMinutes || 10} min</p>
        </div>

        <div class="rounded-2xl border border-orange-100 bg-orange-50/60 p-4 text-center shadow-sm">
          <span class="text-xl">🔥</span>
          <p class="mt-1 text-xs font-medium text-orange-600">Cocción Airfryer</p>
          <p class="text-sm font-extrabold text-orange-700">{recipe.cookTimeMinutes} min</p>
        </div>

        <div class="rounded-2xl border border-amber-100 bg-amber-50/60 p-4 text-center shadow-sm">
          <span class="text-xl">🌡️</span>
          <p class="mt-1 text-xs font-medium text-amber-600">Temperatura</p>
          <p class="text-sm font-extrabold text-amber-700">{recipe.temperatureCelsius}°C</p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-4 text-center shadow-sm">
          <span class="text-xl">🍽️</span>
          <p class="mt-1 text-xs font-medium text-slate-500">Raciones</p>
          <p class="text-sm font-bold text-slate-800">{recipe.servings || 2} pers.</p>
        </div>
      </div>

      <!-- Imagen Principal -->
      {recipe.imageUrl && (
        <div class="mb-12 overflow-hidden rounded-3xl border border-slate-200 bg-slate-100 shadow-md">
          <img 
            src={recipe.imageUrl} 
            alt={recipe.title}
            class="h-72 w-full object-cover sm:h-96"
          />
        </div>
      )}

      <!-- Contenido Principal: 2 Columnas -->
      <div class="grid gap-8 lg:grid-cols-12">
        <!-- Columna Izquierda: Ingredientes -->
        <aside class="lg:col-span-4">
          <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
            <h2 class="text-xl font-extrabold text-slate-900 flex items-center gap-2 mb-4">
              <span>🛒</span> Ingredientes
            </h2>
            <ul class="space-y-3">
              {recipe.ingredients?.map((ingredient: string) => (
                <li class="flex items-start gap-3 text-sm text-slate-700">
                  <input 
                    type="checkbox" 
                    class="mt-1 h-4 w-4 rounded border-slate-300 text-orange-600 focus:ring-orange-500 cursor-pointer"
                  />
                  <span class="select-none leading-snug">{ingredient}</span>
                </li>
              ))}
            </ul>
          </div>
        </aside>

        <!-- Columna Derecha: Pasos de Preparación + Tips -->
        <section class="lg:col-span-8">
          <h2 class="text-2xl font-extrabold text-slate-900 flex items-center gap-2 mb-6">
            <span>👨‍🍳</span> Paso a paso en la cesta
          </h2>

          <ol class="space-y-4">
            {recipe.steps?.map((step: string, index: number) => (
              <li class="flex gap-4 rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-orange-600 text-sm font-extrabold text-white">
                  {index + 1}
                </span>
                <p class="mt-1 text-sm text-slate-700 leading-relaxed">
                  {step}
                </p>
              </li>
            ))}
          </ol>

          <!-- Bloque de Consejos / Tips -->
          {recipe.tips && recipe.tips.length > 0 && (
            <div class="mt-8 rounded-3xl border border-amber-200 bg-gradient-to-br from-amber-50 to-orange-50 p-6 shadow-sm">
              <h3 class="text-lg font-bold text-amber-900 flex items-center gap-2 mb-3">
                💡 Consejos de Chef para Airfryer
              </h3>
              <ul class="space-y-2 text-sm text-amber-900/90">
                {recipe.tips.map((tip: string) => (
                  <li class="flex items-start gap-2">
                    <span class="text-amber-600 font-bold">•</span>
                    <span>{tip}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>
      </div>
    </main>
  </div>
</Layout>